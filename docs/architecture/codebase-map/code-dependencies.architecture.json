    {
      "dot": "cyan",
      "title": "How to read it",
      "items": [
        "Arrows = compile-time imports from the GitNexus index (commit d10575e)",
        "Edge numbers = import statements crossing the module boundary"
      ]
    },
    {
      "dot": "emerald",
      "title": "Healthy boundaries",
      "items": [
        "engine/ never imports platform/",
        "ruleforge-core depends only on slf4j + Jackson",
        "Services never import each other; they talk over HTTP/Kafka"
      ]
    },
    {
      "dot": "amber",
      "title": "Watch",
      "items": [
        "management + solver each register all 9 engines",
        "ruleforge-all omits flow, script, dmn, cep, hierarchy",
        "starter lacks AutoConfiguration.imports"
      ]
    }
