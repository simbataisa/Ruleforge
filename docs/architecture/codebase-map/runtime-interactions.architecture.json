        "label": "Audit and analytics",
        "focus": [
          "kafka",
          "event",
          "analytics",
          "postgres",
          "elastic"
        ],
        "note": "event-service and analytics-service consume Kafka to build the audit trail and decision analytics."
      }
    ]
