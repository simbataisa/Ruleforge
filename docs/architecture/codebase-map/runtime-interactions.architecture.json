  "cards": [
    {
      "dot": "cyan",
      "title": "Not drawn",
      "items": [
        "Web UI reaches every service via the Vite proxy (local) or Kong (Docker)",
        "solver also publishes rule.execution to Kafka",
        "connector-service (:8087) only makes outbound JDBC/HTTP calls; nothing calls its /internal endpoint"
      ]
    },
    {
      "dot": "rose",
      "title": "Gaps",
      "items": [
        "Kong has no route to event-service; /v1/webhooks points at management",
        "user.activity has no producer; system.events and MinIO are unused",
        "SSO SAML/OIDC handlers are placeholders"
      ]
    }
  ]
