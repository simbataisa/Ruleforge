                    {
                      "type": "frame",
                      "id": "nGy3O",
                      "name": "scrCode",
                      "width": "fill_container",
                      "height": "fill_container",
                      "fill": "#1E1E2E",
                      "layout": "vertical",
                      "gap": 4,
                      "padding": 16,
                      "children": [
                        {
                          "type": "text",
                          "id": "TnGxm",
                          "name": "scrC1",
                          "fill": "#6B7280",
                          "content": "// Custom pricing logic — JavaScript",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "qw9Xv",
                          "name": "scrC2",
                          "fill": "#89B4FA",
                          "content": "function evaluate(facts) {",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "k4F2i",
                          "name": "scrC3",
                          "fill": "#CDD6F4",
                          "content": "  const base = facts.basePrice;",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "4kNHO",
                          "name": "scrC4",
                          "fill": "#CDD6F4",
                          "content": "  const tier = facts.customerTier;",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "bOtOK",
                          "name": "scrC5",
                          "fill": "#CDD6F4",
                          "content": "  const discount = tier === 'GOLD' ? 0.2 : 0.05;",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "wEfdo",
                          "name": "scrC6",
                          "fill": "#A6E3A1",
                          "content": "  return { finalPrice: base * (1 - discount) };",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "KdTai",
                          "name": "scrC7",
                          "fill": "#89B4FA",
                          "content": "}",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
